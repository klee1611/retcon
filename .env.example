# Copy this file to .env and fill in real values. Never commit .env.

# Required
# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=
# LLM for the agent (openai/gpt-oss-120b on Groq)
GROQ_API_KEY=

# Local dev over plain http: the session cookie must not be Secure
COOKIE_SECURE=0

# Optional (defaults shown). Uncomment to change.
# RETCON_DB=retcon
# ALLOWED_ORIGINS=https://example.com      # extra allowed Origins for POSTs, comma-separated
# IP_HASH_SALT=<random string>             # set in production; client IPs are stored hashed
# TRUST_PROXY_HEADERS=1                    # only behind Vercel or another trusted proxy
# SESSION_LLM_CALLS=30
# IP_SESSIONS_PER_HOUR=5
# DAILY_LLM_CALLS=1000
# MONGO_TIMEOUT_MS=3000
