# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas sandbox connection string (mongodb+srv://...)
MONGODB_URI=

# Voyage AI embeddings (200M free tokens during the event)
VOYAGE_API_KEY=

# LangSmith tracing (traces link each memory to its run)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=retcon

# LLM for the demo agent (required for the before/after refund demo)
GROQ_API_KEY=
