---
title: Retcon - governed agent memory on MongoDB Atlas
---
flowchart LR
    subgraph inputs["Inputs and LLM"]
        direction TB
        C(["Customer<br/><i>trusted conversation</i>"])
        U(["Untrusted content<br/><i>reviews, webpages, tool output</i>"])
        G["Groq LLM<br/>gpt-oss-120b"]
    end

    subgraph app["Retcon (Python)"]
        direction TB
        A["<b>Shopping Agent</b><br/>LangGraph<br/>tools: issue_refund, forget_memory"]
        S["<b>RetconStore</b><br/>one checked write path<br/>source policy + attack patterns<br/>adaptive trust, fail closed<br/>reads filtered per user"]
        R["<b>Rollback</b><br/>restore + diff"]
        D["<b>Dashboard</b><br/>FastAPI + SSE"]
    end

    subgraph atlas["MongoDB Atlas"]
        direction TB
        H[("<b>memory_history</b><br/>audit trail")]
        M[("<b>memories</b><br/>Vector Search<br/>Automated Embeddings")]
        T[("<b>sources + attack_patterns</b><br/>trust · known injections")]
        Q[("<b>quarantine</b><br/>blocked writes")]
    end

    O(["Operator"])

    C -->|chats| A
    U -->|read by agent| A
    G <-->|LLM calls| A
    A -->|put / search| S
    S -->|allowed| M
    S -->|blocked| Q
    S -->|records| H
    S <-->|trust, pattern match| T
    M -.->|Change Streams| D
    O --> D
    D -->|rollback| R
    R -->|reads| H
    R -->|restores| M

    classDef untrusted fill:#fde2e1,stroke:#d1242f,color:#82071e
    classDef trusted fill:#ddf4ff,stroke:#0969da,color:#0a3069
    classDef core fill:#fff8c5,stroke:#9a6700,color:#4d2d00,stroke-width:2px
    classDef svc fill:#f6f8fa,stroke:#57606a,color:#24292f
    classDef db fill:#e3f6ec,stroke:#00684a,color:#00402c
    class U untrusted
    class C,O trusted
    class S core
    class A,R,D,G svc
    class M,Q,H,T db
    style atlas fill:#f3fbf6,stroke:#00684a
    style app fill:#fafafa,stroke:#8c959f
    style inputs fill:#ffffff,stroke:#d0d7de
